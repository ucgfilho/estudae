# Configurações do Servidor e Banco de Dados em Nuvem (MongoDB Atlas)
# Copie este arquivo para .env (que é ignorado pelo Git) e defina seus segredos locais.

PORT=8080
NODE_ENV=development
MONGODB_URI=
SEED_FILE_PATH=

# Para uma instalação nova, gere dois valores com openssl rand -hex 32.
# Em uma migração, DATA_ENCRYPTION_KEY precisa manter a chave usada pelo banco atual.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
TRUSTED_PROXY_IPS=

# Credenciais opcionais de bootstrap local (NUNCA faça commit de dados reais no repositório)
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=
DEFAULT_USER_NAME=

